    "axios-cookiejar-support": "^7.0.0",
    "fast-xml-parser": "^5.11.1",
    "neverthrow": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "tough-cookie": "^6.0.2",
    "ts-mixer": "^6.0.4",
    "undici": "^8.10.2"
